{
  "compilerOptions": {
    "target": "ES2021",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["ES2021", "DOM"],
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src", "scripts"]
}

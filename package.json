{
  "name": "chatgpt-helper-extension",
  "version": "2.7.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-content.mjs",
    "check": "node scripts/check-content.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/test-browser.mjs && node scripts/test-export-browser.mjs",
    "package": "npm run build && npm run check && node scripts/package-extension.mjs",
    "test:services": "node scripts/test-services.mjs",
    "test:extension": "node scripts/test-extension.mjs",
    "test:adversarial": "npm run test:services && npm run test:extension"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.3",
    "hast-util-to-html": "^8.0.4",
    "highlight.js": "^11.7.0",
    "i18next": "^22.5.1",
    "jszip": "3.9.1",
    "katex": "^0.16.3",
    "mdast-util-from-markdown": "^1.3.1",
    "mdast-util-gfm": "^2.0.2",
    "mdast-util-to-hast": "^12.3.0",
    "mdast-util-to-markdown": "^1.5.0",
    "micromark-extension-gfm": "^2.0.3",
    "preact": "^10.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^12.3.1",
    "sanitize-filename": "^1.6.3"
  },
  "devDependencies": {
    "@types/mdast": "^3.0.15",
    "@types/node": "^20.11.20",
    "@types/unist": "^2.0.10",
    "typescript": "^5.5.2",
    "vite": "^5.3.2",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "@preact/preset-vite": "^2.8.3"
  }
}

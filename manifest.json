{
  "manifest_version": 3,
  "name": "ChatGPT Helper",
  "version": "2.4.3",
  "description": "ChatGPT Helper：贴近 ChatGPT 的轻量效率面板，提供提示词管理、对话大纲、会话整理、多格式导出与阅读定位增强",
  "author": "zhiwuyazhe_fjr",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "libs/jszip.min.js",
        "libs/html2canvas.min.js",
        "content-scripts/gm-api-adapter.js",
        "content-scripts/dist/chatgpt-exporter.js",
        "content-scripts/dist/chatgpt-helper.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "libs/*.js",
        "icons/logo.svg"
      ],
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ]
    }
  ]
}
